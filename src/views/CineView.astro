---
import Layout from '../layouts/Layout.astro';
import Moons from '../components/Moons.astro';
import { Image } from 'astro:assets';
import { published } from '../lib/content';
import { SECTIONS, localize, ui, formatDate, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const films = (await published('cine')).sort((a, b) => b.data.vista.getTime() - a.data.vista.getTime());
const avg = films.length ? Math.round((films.reduce((s, f) => s + f.data.calificacion, 0) / films.length) * 2) / 2 : 0;
---
<Layout title={SECTIONS.cine[lang]} lang={lang} section="cine" description={t.cineIntro}>
  <h2 class="section-kicker">&gt; {lang === 'es' ? 'CINEMATECA / SALA_OSCURA' : 'CINEMATHEQUE / DARK_ROOM'}</h2>
  <p class="section-intro">{t.cineIntro}</p>

  <div class="section-body">
    {films.length === 0 ? <p class="empty-room">{t.empty}</p> : (
      <>
        <div class="toolbar">
          <span class="stats">
            {films.length} {lang === 'es' ? (films.length === 1 ? 'película' : 'películas') : (films.length === 1 ? 'film' : 'films')} · {lang === 'es' ? 'luna promedio' : 'average moon'}
            <Moons value={avg} lang={lang} size={13} />
          </span>
          <div class="chip-row" role="group" aria-label={t.sortBy} data-sort-group>
            <button class="chip" type="button" data-sort="vista" aria-pressed="true">{t.sortRecent}</button>
            <button class="chip" type="button" data-sort="luna" aria-pressed="false">{t.sortRating}</button>
            <button class="chip" type="button" data-sort="anio" aria-pressed="false">{t.sortYear}</button>
          </div>
        </div>
        <ul class="films" data-sort-list>
          {films.map((f) => (
            <li data-vista={f.data.vista.getTime()} data-luna={f.data.calificacion} data-anio={f.data.anio ?? 0}>
              <a href={localize(`/cine/${f.id}`, lang)} class="film">
                <div class="poster">
                  {f.data.poster
                    ? <Image src={f.data.poster} alt="" width={300} height={450} />
                    : <span class="no-poster" aria-hidden="true">{f.data.titulo.slice(0, 1)}</span>}
                </div>
                <h3>{f.data.titulo}</h3>
                <p class="film-meta">{[f.data.anio, f.data.direccion].filter(Boolean).join(' · ')}</p>
                <Moons value={f.data.calificacion} lang={lang} size={14} />
                <p class="film-date">{formatDate(f.data.vista, lang)}{f.data.borrador && ' · DRAFT'}</p>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}
  </div>
</Layout>
<script>
  // Ordenar sin recargar (recientes / luna / año)
  document.addEventListener('astro:page-load', () => {
    const group = document.querySelector('[data-sort-group]');
    const list = document.querySelector('[data-sort-list]');
    if (!group || !list) return;
    group.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button[data-sort]') as HTMLButtonElement | null;
      if (!btn) return;
      const key = btn.dataset.sort!;
      group.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      [...list.children]
        .sort((a, b) => Number((b as HTMLElement).dataset[key]) - Number((a as HTMLElement).dataset[key]))
        .forEach((li) => list.appendChild(li));
    });
  });
</script>
<style>
  .toolbar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1.5rem; }
  .toolbar .chip-row { margin: 0; }
  .stats { font-size: 0.8rem; color: var(--color-text-accent); display: inline-flex; gap: 0.6rem; align-items: center; flex-wrap: wrap; }
  .films { list-style: none; margin: 0; padding: 0; display: grid; gap: 2rem 1.4rem; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); }
  .film { display: block; text-decoration: none; color: inherit; }
  .poster { aspect-ratio: 2 / 3; background: #000; border: 1px solid var(--color-line); overflow: hidden; margin-bottom: 0.7rem; display: flex; align-items: center; justify-content: center; }
  .poster img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.85) contrast(1.05); transition: filter .5s, transform .7s; }
  .film:hover .poster img { filter: none; transform: scale(1.04); }
  .film:hover .poster { border-color: var(--color-highlight); }
  .no-poster { font-size: 3rem; color: #333; }
  .film h3 { font-weight: normal; font-size: 0.95rem; margin: 0 0 0.2rem; line-height: 1.3; color: var(--color-text-light); }
  .film:hover h3 { color: var(--color-highlight); }
  .film-meta, .film-date { font-size: 0.72rem; color: var(--color-text-accent); margin: 0 0 0.35rem; }
  .film-date { margin-top: 0.35rem; }
</style>
