---
import BaseLayout from '../layouts/Layout.astro';
import VideoHall from '../components/VideoHall.astro';
import VideoDeck from '../components/VideoDeck.jsx';
import { getCollection } from 'astro:content';
import { youtubeId } from '../lib/youtube';
import { SECTIONS, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = {
  es: {
    intro: ">> ACCEDIENDO AL ARCHIVO...",
    scroll: "Desliza hacia abajo para entrar a la sala virtual.",
    deck: ">> MAZO VIRTUAL",
    swipe: "Desliza las tarjetas para recorrer el archivo.",
    description: "El museo audiovisual de Jose Shōta: una sala virtual de videos, nostalgia y vaporwave.",
  },
  en: {
    intro: ">> ACCESSING ARCHIVE...",
    scroll: "Scroll down to enter the Virtual Hall.",
    deck: ">> VIRTUAL DECK",
    swipe: "Swipe cards to browse the archive.",
    description: "Jose Shōta's audiovisual museum: a virtual hall of videos, nostalgia and vaporwave.",
  },
}[lang];

const videos = (await getCollection('museo'))
  .sort((a, b) => a.data.orden - b.data.orden)
  .map((v, i) => ({
    id: youtubeId(v.data.youtube) || v.data.youtube,
    n: i + 1,
    title: v.data.titulo,
    desc: (lang === 'en' && v.data.descripcionEn) || v.data.descripcion,
  }));

// Altura de scroll de la sala 3D en escritorio
const totalHeight = Math.max(2000, videos.length * 900) + "px";
---

<BaseLayout title={SECTIONS.videos[lang]} lang={lang} section="videos" description={copy.description} fullWidth={true}>
    
    <div class="desktop-view">
        <div class="intro-overlay">
            <h2>{copy.intro}</h2>
            <p>{copy.scroll}</p>
            <div class="arrow">↓</div>
        </div>

        <VideoHall videos={videos} lang={lang} />

        <div style={`height: ${totalHeight};`}></div>
    </div>

    <div class="mobile-view">
        <div class="mobile-header">
            <h2>{copy.deck}</h2>
            <p>{copy.swipe}</p>
        </div>
        
        <VideoDeck client:load videos={videos} lang={lang} />
    </div>

</BaseLayout>

<style>
    /* --- MEDIA QUERIES FOR SWITCHING --- */
    
    /* DEFAULT: Desktop/Mouse device (The Hall) */
    .desktop-view {
        display: block;
    }
    /* RULE 1 & 2 combined logic for .mobile-view */
    /* We make the container a flex column so items sit naturally */
    .mobile-view {
        display: block; /* Triggered by media queries */
        height: 100dvh;
        width: 100%;
        overflow: hidden;
        display: flex;            /* <--- CHANGE: Flexbox */
        flex-direction: column;   /* <--- CHANGE: Vertical Stack */
        justify-content: center;  /* <--- CHANGE: Center content vertically */
        align-items: center;      /* <--- CHANGE: Center content horizontally */
        padding-bottom: 2rem;     /* Add some bottom breathing room */
    }
    /* En escritorio sin preferencias especiales, el mazo móvil no se muestra */
    @media (pointer: fine) and (min-width: 769px) and (prefers-reduced-motion: no-preference) {
        .mobile-view { display: none !important; }
    }

    /* RULE 1: STRICTLY TOUCH DEVICES 
       We removed the width constraint here. 
       If the user is using a finger (coarse pointer), they get the Deck.
       This catches iPad Pro in Landscape (which is wide) without hurting Laptops (which use mouse).
    */
    @media (pointer: coarse) {
        .desktop-view { display: none; }
        .mobile-view  { 
            display: block; 
            height: auto;
            overflow: hidden;
            padding-top: 0;
        }
    }

    /* RULE 2: TINY SCREENS (Phones/Small Windows)
       We keep this at 768px. 
       Most laptops are at least 1024px or 1280px wide. 
       This ensures that if a computer user resizes their window somewhat small, 
       they generally keep the 3D Hall until it becomes absurdly narrow.
    */
    @media (max-width: 768px), (prefers-reduced-motion: reduce) {
        .desktop-view { display: none; }
        .mobile-view  { 
            display: block; 
            height: auto;
            overflow: hidden;
            padding-top: 0;
        }
    }

    /* --- YOUR EXISTING STYLES --- */
    .intro-overlay {
        position: relative;
        z-index: 10;
        text-align: center;
        margin-top: 10vh;
        margin-bottom: 20vh;
        pointer-events: none;
    }
    
    .intro-overlay h2 {
        background: var(--color-bg);
        display: inline-block;
        padding: 0.5rem;
        border: 1px solid var(--color-highlight);
        color: var(--color-highlight);
    }

    .arrow {
        font-size: 2rem;
        animation: bounce 2s infinite;
        margin-top: 1rem;
    }

    /* Mobile Header Styling */
    /* Adjust header to not have huge margins, let Flexbox handle the gap */
    .mobile-header {
        text-align: center;
        margin-top: 0;
        margin-bottom: 1rem;     /* Small bottom gap before deck */
        flex-shrink: 0;          /* Prevent header from squishing */
        z-index: 20;
    }
    .mobile-header h2 {
        color: var(--color-highlight);
        font-size: 1.2rem;
        border: 1px dashed var(--color-highlight);
        display: inline-block;
        padding: 5px 10px;
        margin-bottom: 5px;
    }
    .mobile-header p {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        color: var(--color-text-accent);
    }

    @keyframes bounce {
        0%, 20%, 50%, 80%, 100% {transform: translateY(0);}
        40% {transform: translateY(-10px);}
        60% {transform: translateY(-5px);}
    }
</style>