---
import Layout from '../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';
import { settings } from '../lib/content';
import { SECTIONS, ui, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const page = await getEntry('sobre', lang);
const Content = page ? (await render(page)).Content : null;
const { correo } = await settings();
---
<Layout title={page?.data.titulo || SECTIONS.sobre[lang]} lang={lang} section="sobre">
  <div class="sobre">
    <div class="prose">{Content && <Content />}</div>

    <aside class="rights" id={lang === 'es' ? 'derechos' : 'rights'}>
      <h2>{t.rightsTitle}</h2>
      <p>{t.rightsBody}</p>
      <p>{t.noCommercial}</p>
      {correo && (
        <p class="mail">
          <span>{t.contact}:</span>
          <a href={`mailto:${correo}?subject=${encodeURIComponent(lang === 'es' ? 'Cueva — derechos' : 'Cave — rights')}`}>{correo}</a>
        </p>
      )}
    </aside>
  </div>
</Layout>
<style>
  .sobre { display: grid; gap: 3rem; }
  .rights { max-width: 68ch; border: 1px solid var(--color-line); background: #000; padding: 1.2rem 1.4rem; font-size: 0.88rem; }
  .rights h2 { margin: 0 0 0.8rem; font-weight: normal; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-highlight); }
  .rights p { margin: 0.5rem 0; color: #c9c9c9; }
  .mail { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 1rem !important; }
  .mail span { color: var(--color-text-accent); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.08em; padding-top: 0.15rem; }
</style>
