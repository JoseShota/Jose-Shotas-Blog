---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';
import GlobalPlayer from '../components/player/GlobalPlayer.jsx';
import { SITE, SECTIONS, NAV_GROUPS, localize, unlocalize, ui, type Lang, type SectionKey } from '../lib/i18n';

interface Props {
  title: string;              // título de la página (pestaña y <h1>)
  lang: Lang;
  section?: SectionKey;       // sección activa en el menú
  heading?: string | false;   // <h1> visible (por defecto = title; false = sin h1 en cabecera)
  description?: string;
  image?: string;             // imagen para compartir (URL absoluta o ruta)
  alternate?: string;         // URL de esta misma página en el otro idioma
  canonical?: string;
  fullWidth?: boolean;
  noindex?: boolean;
}

const {
  title, lang, section, heading = title, description, image, alternate, canonical,
  fullWidth = false, noindex = false,
} = Astro.props;

const t = ui[lang];
const site = SITE[lang];
const other: Lang = lang === 'es' ? 'en' : 'es';
const basePath = unlocalize(Astro.url.pathname);
const altHref = alternate ?? localize(basePath, other);
const selfHref = localize(basePath, lang);
const urls = { es: lang === 'es' ? selfHref : altHref, en: lang === 'en' ? selfHref : altHref };

const fullTitle = section === 'lobby' ? `${site.name} — ${site.by}` : `${title} — ${site.name}`;
const desc = description || (lang === 'es'
  ? 'Archivo personal de Jose Shōta: escritos, curaduría musical, videos, películas, libros y estudios.'
  : "Jose Shōta's personal archive: writings, music curation, videos, films, books and studies.");
const canonicalUrl = new URL(canonical || selfHref, Astro.site).href;
const ogImage = new URL(image || '/og-default.png', Astro.site).href;

// Datos mínimos de las colecciones para el mini-reproductor
const curaduria = await getCollection('curaduria');
const playerCollections = Object.fromEntries(
  curaduria.map((c) => [c.data.pistas, {
    title: lang === 'en' && c.data.tituloEn ? c.data.tituloEn : c.data.titulo,
    cover: c.data.portadaUrl,
  }])
);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={new URL(urls.es, Astro.site).href} />
    <link rel="alternate" hreflang="en" href={new URL(urls.en, Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(urls.es, Astro.site).href} />
    <link rel="alternate" type="application/rss+xml" title={`${SECTIONS.bitacora[lang]} — ${site.name}`} href={localize('/rss.xml', lang)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#111111" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
  </head>

  <body class={fullWidth ? 'fullWidth' : ''}>
    <a class="skip-link" href="#contenido">{t.skip}</a>

    <header class:list={['site-header', { 'header-constrained': fullWidth }]}>
      <div class="brand-row">
        <a class="brand" href={localize('/', lang)}>
          {site.name}<span class="ja" lang="ja">{SITE.ja}</span>{site.by}
        </a>
        <nav class="lang-switch" aria-label="Idioma / Language">
          <a href={urls.es} hreflang="es" lang="es" aria-current={lang === 'es' ? 'true' : undefined}>[ES]</a>
          <a href={urls.en} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>[EN]</a>
        </nav>
      </div>

      {heading && <h1 class="page-title">{heading}</h1>}

      <nav class="site-nav" aria-label={t.menu}>
        {[false, true].map((mobile) => {
          const list = (
            <ul class="nav-groups">
              {NAV_GROUPS.map((g) => (
                <li class="nav-group">
                  {g[lang] && <span class="nav-group-label" aria-hidden="true">{g[lang]}</span>}
                  {g.items.map((key) => (
                    <a href={localize(SECTIONS[key].path, lang)} aria-current={section === key ? 'page' : undefined}>
                      [{SECTIONS[key][lang]}]
                    </a>
                  ))}
                </li>
              ))}
            </ul>
          );
          return mobile ? (
            <details class="nav-mobile">
              <summary>[ ≡ {t.menu} ]</summary>
              {list}
            </details>
          ) : (
            <div class="nav-desktop">{list}</div>
          );
        })}
      </nav>
    </header>

    <main id="contenido">
      <slot />
    </main>

    {!fullWidth && (
      <footer class="site-footer">
        <span>© {new Date().getFullYear()} Jose Shōta · {t.footer}</span>
        <span>
          <a href={localize('/sobre', lang)}>{SECTIONS.sobre[lang]}</a> ·
          <a href={localize('/rss.xml', lang)}>RSS</a>
        </span>
      </footer>
    )}

    <GlobalPlayer client:only="react" transition:persist="cueva-player" lang={lang} collections={playerCollections} />
  </body>
</html>

<script>
  // Cierra el menú móvil al navegar
  document.addEventListener('astro:after-swap', () => {
    document.querySelectorAll('details.nav-mobile[open]').forEach((d) => d.removeAttribute('open'));
  });
</script>
