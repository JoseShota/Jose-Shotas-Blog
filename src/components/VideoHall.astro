---
// Sala 3D del museo (escritorio). Las miniaturas se cargan al instante y el
// reproductor de YouTube solo aparece al inspeccionar una pieza.
interface Props { videos: { id: string; n: number; title: string; desc: string }[]; lang: 'es' | 'en' }
const { videos, lang } = Astro.props;
const Z_SPACING = 800; // profundidad entre videos
const X_OFFSET = 350;  // separación izquierda/derecha
const inspect = lang === 'es' ? '[ INSPECCIONAR ]' : '[ INSPECT DATA ]';
const endLabel = lang === 'es' ? '[ FIN DEL ARCHIVO ]' : '[ END OF ARCHIVE ]';
---

<div class="hall-container">
  <div class="hall-scene" id="hallScene">
    <div class="floor-grid"></div>

    {videos.map((video, index) => {
      const isLeft = index % 2 === 0;
      const xPos = isLeft ? X_OFFSET : -X_OFFSET;
      const rotationY = isLeft ? -15 : 15;
      const zPos = index * -Z_SPACING;
      return (
        <div
          class="video-frame"
          id={`frame-${index}`}
          data-z={zPos}
          data-yt={video.id}
          style={`--base-transform: translate3d(${xPos}px, 0, ${zPos}px) rotateY(${rotationY}deg);`}
        >
          <button type="button" class="click-overlay" data-focus={index} aria-label={`${inspect} ${video.title}`}>
            <span class="inspect-hint">{inspect}</span>
          </button>

          <div class="video-wrapper">
            <img src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`} alt="" loading={index < 2 ? 'eager' : 'lazy'} />
          </div>

          <div class="video-meta">
            <span class="index-marker">No. {String(video.n).padStart(2, '0')}</span>
            <h3>{video.title}</h3>
            <p class="cueva-muted desc-text">{video.desc}</p>
          </div>
        </div>
      );
    })}

    <div class="end-marker" style={`transform: translate3d(0, 0, ${(videos.length * -Z_SPACING) - 500}px)`}>
      {endLabel}
    </div>
  </div>
</div>

<style is:global>
  /* When inspecting, we hide the Intro Text in the parent page */
  body.inspecting-mode .intro-overlay {
    opacity: 0;
    filter: blur(10px); /* Retro "Signal Lost" effect */
    transform: scale(0.9);
    pointer-events: none;
    transition: all 0.5s ease-out;
  }
  /* --- NEW: HIDE OTHER FRAMES WHEN INSPECTING --- */
  /* Select all frames that are NOT the currently focused one */
  body.inspecting-mode .video-frame:not(.is-focused) {
    /* Move them far up (negative Y) and tilt them back slightly */
    transform: translateY(-150vh) rotateX(20deg) !important; 
    /* Fade them out */
    opacity: 0;
    /* Make them unclickable while gone */
    pointer-events: none;
    /* A slower, smoother transition for the "fly away" effect */
    transition: all 0.8s cubic-bezier(0.5, 0, 0, 1);
  }
  
  /* Ensure the intro text has a transition by default so it comes back smoothly */
  .intro-overlay {
    transition: all 0.5s ease-in;
  }
</style>

<script>
  // Motor de la sala: scroll -> profundidad; clic -> inspeccionar.
  // Se inicializa en cada visita y se limpia al salir (navegación sin recarga).
  document.addEventListener('astro:page-load', () => {
    const scene = document.getElementById('hallScene');
    if (!scene) return;
    const speedFactor = 2.5;
    let current: number | null = null;

    const onScroll = () => { scene.style.transform = `translateZ(${window.scrollY * speedFactor}px)`; };

    const frameOf = (i: number) => document.getElementById(`frame-${i}`) as HTMLElement | null;

    const reset = (i: number) => {
      const frame = frameOf(i);
      if (!frame) return;
      frame.classList.remove('is-focused');
      frame.style.transform = '';
      frame.style.zIndex = 'auto';
      frame.querySelector('iframe')?.remove();
      frame.querySelector<HTMLElement>('.video-wrapper img')?.removeAttribute('hidden');
      const overlay = frame.querySelector<HTMLElement>('.click-overlay');
      setTimeout(() => { if (overlay) { overlay.style.pointerEvents = 'auto'; overlay.style.opacity = '1'; } }, 100);
    };

    const close = () => {
      if (current === null) return;
      const idx = current;
      current = null;
      reset(idx);
      document.body.classList.remove('inspecting-mode');
      frameOf(idx)?.querySelector<HTMLElement>('.click-overlay')?.focus({ preventScroll: true });
    };

    const focus = (i: number) => {
      if (current === i) return;
      if (current !== null) reset(current);
      const frame = frameOf(i);
      if (!frame) return;
      current = i;
      frame.classList.add('is-focused');
      document.body.classList.add('inspecting-mode');
      const overlay = frame.querySelector<HTMLElement>('.click-overlay')!;
      overlay.style.pointerEvents = 'none';
      overlay.style.opacity = '0';
      const z = Number(frame.dataset.z);
      frame.style.transform = `translate3d(0px, 0px, ${z + 350}px) rotateY(0deg) scale(1.1)`;
      frame.style.zIndex = '100';
      // carga el reproductor real solo ahora
      const wrapper = frame.querySelector('.video-wrapper')!;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${frame.dataset.yt}?autoplay=1`;
      iframe.title = frame.querySelector('h3')?.textContent || 'YouTube';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      wrapper.querySelector('img')?.setAttribute('hidden', '');
      wrapper.appendChild(iframe);
      window.dispatchEvent(new CustomEvent('cueva:pause-music'));
    };

    const onClick = (e: MouseEvent) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-focus]');
      if (btn) { e.stopPropagation(); focus(Number(btn.dataset.focus)); return; }
      if (current !== null && !frameOf(current)?.contains(e.target as Node)) close();
    };
    const onKey = (e: KeyboardEvent) => { if (e.key === 'Escape') close(); };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('click', onClick);
    window.addEventListener('keydown', onKey);
    window.addEventListener('cueva:music-play', close);
    onScroll();

    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('click', onClick);
      window.removeEventListener('keydown', onKey);
      window.removeEventListener('cueva:music-play', close);
      document.body.classList.remove('inspecting-mode');
    }, { once: true });
  });
</script>

<style>
  /* --- BASE --- */
  .hall-container {
    height: 100vh;
    width: 100%;
    position: fixed;
    top: 0;
    left: 0;
    overflow: hidden;
    perspective: 1000px; 
    z-index: 1; 
    pointer-events: none; 
  }

  .hall-scene {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 50%;
    left: 50%;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .floor-grid {
    position: absolute;
    width: 200vw;
    height: 20000px; 
    background: 
      linear-gradient(var(--color-text-accent) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-text-accent) 1px, transparent 1px);
    background-size: 50px 50px;
    background-position: center;
    transform: rotateX(90deg) translateZ(300px) translateY(-50%);
    opacity: 0.1;
  }

  /* --- CARD --- */
  .video-frame {
    position: absolute;
    width: 420px; 
    left: -210px; 
    top: -180px; /* Adjusted slightly up to center better */
    background: #050505;
    border: 1px solid #333;
    padding: 10px;
    pointer-events: auto; 
    
    transform: var(--base-transform);
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), 
                border-color 0.3s, 
                box-shadow 0.3s;
  }

  .video-frame:hover {
    border-color: var(--color-text-accent);
  }

  .video-frame.is-focused {
    border-color: var(--color-highlight);
    box-shadow: 0 0 60px rgba(35, 144, 158, 0.25);
  }

  /* --- GLASS OVERLAY (UPDATED) --- */
  .click-overlay {
    border: 0;
    padding: 0;
    font: inherit;
    width: 100%;
    position: absolute;
    inset: 0; /* Covers EVERYTHING inside the border */
    z-index: 50;
    cursor: pointer;
    background: rgba(0, 0, 0, 0.01); /* Basically transparent but registers clicks */
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s;
  }
  
  .click-overlay:hover {
    background: rgba(35, 144, 158, 0.05); /* Very subtle tint on hover */
  }

  .inspect-hint {
    color: var(--color-highlight);
    font-family: var(--font-mono);
    font-weight: bold;
    opacity: 0;
    transform: scale(0.8);
    transition: all 0.2s;
    background: #000;
    padding: 5px 12px;
    border: 1px dashed var(--color-highlight);
    box-shadow: 0 0 10px #000;
  }

  .click-overlay:hover .inspect-hint,
  .click-overlay:focus-visible .inspect-hint {
    opacity: 1;
    transform: scale(1);
  }

  /* --- CONTENT --- */
  .video-wrapper {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    background: #000;
    margin-bottom: 1rem;
    pointer-events: none; /* Default: video not clickable until focused */
  }
  
  /* When focused, the wrapper allows pointer events (handled by removing overlay) */
  .video-frame.is-focused .video-wrapper {
     pointer-events: auto;
  }

  .video-wrapper img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.85;
  }

  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .video-meta {
    font-family: var(--font-mono);
    text-align: left;
    position: relative;
    z-index: 40; /* Ensure text is below glass usually, but readable */
  }

  .index-marker {
    display: block;
    font-size: 0.7rem;
    color: var(--color-text-accent);
    margin-bottom: 0.2rem;
    border-bottom: 1px dashed #333;
    padding-bottom: 2px;
  }

  .video-meta h3 {
    font-size: 1rem;
    margin: 0.5rem 0;
    color: var(--color-text-light);
  }
  
  .desc-text {
    font-size: 0.8rem;
    transition: all 0.5s ease;
  }

  /* Text Glow Effect */
  .video-frame.is-focused .desc-text {
    color: #fff;
    text-shadow: 0 0 5px rgba(255, 255, 255, 0.6);
  }

  .end-marker {
    position: absolute;
    color: var(--color-highlight);
    font-family: var(--font-mono);
    font-size: 1.5rem;
    left: -100px;
    width: 200px;
    text-align: center;
  }
</style>