---
const { imagenes = [] } = Astro.props;
---
<div class="md-gallery">
  {imagenes.filter((i) => i?.imagen).map((i) => (
    <figure>
      <a href={i.imagen} target="_blank" rel="noopener"><img src={i.imagen} alt={i.pie || ''} loading="lazy" /></a>
      {i.pie && <figcaption>{i.pie}</figcaption>}
    </figure>
  ))}
</div>
<style>
  .md-gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 0.8rem; margin: 1.6em 0; }
  figure { margin: 0; }
  img { width: 100%; aspect-ratio: 1; object-fit: cover; border: 1px solid var(--color-line); filter: grayscale(0.4); transition: filter .4s; }
  img:hover { filter: none; }
  figcaption { font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-text-accent); margin-top: 0.3rem; }
</style>
