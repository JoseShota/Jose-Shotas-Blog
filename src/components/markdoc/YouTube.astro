---
// Video de YouTube "perezoso": solo carga el reproductor al hacer clic
// (más rápido y sin cookies de YouTube hasta que el visitante decide verlo).
import { youtubeId } from '../../lib/youtube';
const { id, pie } = Astro.props;
const vid = youtubeId(id);
---
{vid && (
  <figure class="md-embed">
    <button type="button" class="yt-facade" data-yt={vid} aria-label={`Reproducir video${pie ? ': ' + pie : ''}`}>
      <img src={`https://i.ytimg.com/vi/${vid}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />
      <span class="yt-play" aria-hidden="true">▶</span>
    </button>
    {pie && <figcaption>{pie}</figcaption>}
  </figure>
)}
<script>
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.yt-facade');
    if (!btn) return;
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.yt}?autoplay=1`;
    iframe.title = btn.getAttribute('aria-label') || 'YouTube';
    iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
    iframe.allowFullscreen = true;
    btn.replaceWith(iframe);
    window.dispatchEvent(new CustomEvent('cueva:pause-music'));
  });
</script>
<style>
  .md-embed { margin: 1.5em 0; }
  .yt-facade, .md-embed :global(iframe) {
    display: block; width: 100%; aspect-ratio: 16 / 9; border: 1px solid var(--color-line); background: #000;
    padding: 0; position: relative; cursor: pointer; overflow: hidden;
  }
  .yt-facade img { width: 100%; height: 100%; object-fit: cover; opacity: 0.75; border: 0; transition: opacity .3s; }
  .yt-facade:hover img { opacity: 1; }
  .yt-play {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    font-size: 2.5rem; color: var(--color-highlight); text-shadow: 0 0 12px #000;
  }
  figcaption { font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-text-accent); margin-top: 0.4rem; }
</style>
