---
const { archivo, titulo } = Astro.props;
const name = titulo || (archivo ? decodeURIComponent(String(archivo).split('/').pop()) : '');
const ext = archivo ? String(archivo).split('.').pop()?.toUpperCase() : '';
---
{archivo && (
  <a class="md-file" href={archivo} target="_blank" rel="noopener">
    <span class="md-file-ext">{ext}</span>
    <span>{name}</span>
    <span aria-hidden="true">↗</span>
  </a>
)}
<style>
  .md-file { display: inline-flex; align-items: center; gap: 0.7rem; border: 1px solid var(--color-line); padding: 0.5rem 0.8rem; font-family: var(--font-mono); font-size: 0.85rem; text-decoration: none; margin: 0.5em 0; }
  .md-file:hover { border-color: var(--color-highlight); }
  .md-file-ext { background: var(--color-highlight); color: #000; padding: 0 0.35rem; font-size: 0.7rem; }
</style>
